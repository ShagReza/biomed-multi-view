# Settings the API reads from environment variables. Copy this file to .env for local use and fill in real values;
# .env is not committed. On Cloud Run, the same variables are set in the service settings instead.

# JSON file listing each target and its model (copy models.example.json and change the paths)
MODELS_CONFIG=/path/to/models.json

# Most SMILES per request
MAX_SMILES=50

# "cpu" or "cuda"; leave empty to use a GPU if there is one
DEVICE=cpu
