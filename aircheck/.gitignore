# Models, embeddings, predictions and generated folds (large; recreated by the notebooks)
output/
# Fold files that stratified_cv.py writes next to its input by default
sample_data/cv_*
# The repository's root .gitignore ignores *.sh; keep our notebook runner
!notebooks/run_notebook.sh
# Temporary copies run_recipe.py makes while a step runs
notebooks/.recipe_*
# Logs in the committed example output (the root .gitignore ignores *.log)
!sample_output/**/*.log
